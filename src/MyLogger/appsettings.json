{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "Monitoring": {
    "DataDirectory": "C:\\ProgramData\\MyLogger\\data",
    "DatabaseFileName": "activity.db",
    "MonitoredUsers": [],

    "Rotation": {
      "IntervalDays": 30,
      "MaxSizeMB": 500,
      "RetentionGenerations": 12
    },

    "FileWatcher": {
      "Enabled": true,
      "Paths": [ "D:\\" ],
      "ExcludePathPrefixes": [
        "C:\\Users\\Default\\",
        "C:\\ProgramData\\Package Cache\\"
      ],
      "ExcludeExtensions": [ ".tmp", ".etl", ".log", ".pf" ],
      "DedupeSeconds": 2,
      "MoveCorrelationWindowMs": 500,
      "CreateChangeSuppressWindowMs": 2000
    },

    "Etw": {
      "Enabled": true,
      "IncludeRemovable": true,
      "IncludeNetworkReads": false,
      "WriteFlushSeconds": 5,
      "ExcludeProcesses": [ "MsMpEng", "SearchIndexer", "SearchProtocolHost", "MyLogger" ],
      "AuditReadProcesses": [ "rdpclip" ]
    },

    "SmbAudit": {
      "Enabled": true,
      "IncludeIpcShare": false,
      "IgnoreAttributeOnlyAccess": true,
      "DedupeSeconds": 2
    },

    "Logon": {
      "Enabled": true,
      "IncludeFailedLogon": false
    }
  }
}
